# Loads the two drivers OpenDeepCool's sensor-driver detection probes through, i2c-dev and cpuid,
# just before it runs, under its own conditions, so their device groups exist when the
# detection's device list is made (systemd.resource-control(5): a group that doesn't exist when a
# unit starts isn't added). lm-sensors' sensors-detect loads both itself during the same run
# (lm_sensors 3.6.2, read 2026-11-10); they stay loaded until the next boot, as they would.
# Phase 11 plan, Task 2.
[Unit]
Description=OpenDeepCool sensor driver detection: the drivers it probes through
ConditionPathExists=!/etc/conf.d/lm_sensors
ConditionPathExists=!/etc/modprobe.d/lm_sensors.conf

[Service]
Type=oneshot
# "-": a driver this kernel doesn't have (cpuid outside x86) only takes that probe away.
ExecStart=-/usr/bin/modprobe -a i2c-dev cpuid
TimeoutStartSec=30
# modprobe needs the right to load drivers and nothing else.
CapabilityBoundingSet=CAP_SYS_MODULE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=none
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Back from @privileged, which holds it: loading drivers is the job.
SystemCallFilter=@module
SystemCallErrorNumber=EPERM
UMask=0077
