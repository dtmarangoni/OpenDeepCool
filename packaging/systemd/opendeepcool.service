# OpenDeepCool's display service (docs/spec/settings.md): drives the DeepCool LP360's display
# from boot, the same for every user, and serves the settings app on the system bus. Phase 7
# plan, Task 8: a crash or a hang ends in a restart; it waits for the GPU ranking; and it runs
# sandboxed as its own account.
[Unit]
Description=OpenDeepCool display service
Wants=opendeepcool-gpu-rank.service
After=opendeepcool-gpu-rank.service
# systemd's default limit, 5 starts in 10 s, would stop restarting for good.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/opendeepcool/opendeepcoold
WatchdogSec=15
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
User=opendeepcool
Group=opendeepcool
StateDirectory=opendeepcool
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# A user namespace of its own, with no capabilities outside it. Its account and group map to
# themselves, so the cooler's node and the power counters (group opendeepcool) stay open to it
# (Phase 11 plan, Task 2).
PrivateUsers=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# The system bus is a socket in the file system, which a private network leaves in reach
# (systemd.exec(5)).
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A call outside the filter fails instead of killing the service: NVIDIA's library runs inside
# it, untested in this sandbox (owner, 2026-10-27).
SystemCallErrorNumber=EPERM
DevicePolicy=closed
DeviceAllow=char-hidraw rw
# NVIDIA's library (NVML) reads its GPUs through /dev/nvidiactl and /dev/nvidia<N>, whose device
# groups NVIDIA's kernel driver registers as "nvidiactl" and "nvidia" (its open kernel modules,
# kernel-open/nvidia/nv.c, read 2026-11-10). Named exactly, so the driver's other groups
# (nvidia-uvm, nvidia-caps) stay closed. A group the driver hasn't registered when the service
# starts isn't added (systemd.resource-control(5)), so these lines are harmless without NVIDIA's
# driver. Untested on NVIDIA hardware (Phase 11 plan, Task 1).
DeviceAllow=char-nvidiactl rw
DeviceAllow=char-nvidia rw

[Install]
WantedBy=multi-user.target
