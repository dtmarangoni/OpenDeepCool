<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
        "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  OpenDeepCool's polkit actions (docs/spec/dbus.md, Names; Phase 7 plan, Task 8). Only the
  active local session may read or change anything, or send the Music modes its sound (owner,
  2026-10-26; Phase 9 plan, Task 3). Each action the service checks names the service's account
  as its owner, so the service, which isn't root, may ask polkit about its callers (polkit(8),
  Declaring actions; owner, 2026-10-29). The last one is pkexec's, for the Start at boot switch.
-->
<policyconfig>
  <vendor>OpenDeepCool</vendor>
  <vendor_url>https://github.com/dtmarangoni/OpenDeepCool</vendor_url>

  <action id="io.github.dtmarangoni.OpenDeepCool1.use">
    <description>Read the cooler display's settings and status</description>
    <message>Authentication is required to read the cooler display's settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:opendeepcool</annotate>
  </action>

  <action id="io.github.dtmarangoni.OpenDeepCool1.change-settings">
    <description>Change the cooler display's settings</description>
    <message>Authentication is required to change the cooler display's settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:opendeepcool</annotate>
  </action>

  <!-- Phase 9: the session's helper hands the service its sound, for the Music modes only. -->
  <action id="io.github.dtmarangoni.OpenDeepCool1.feed-audio">
    <description>Send the session's sound to the cooler display's Music modes</description>
    <message>Authentication is required to send sound to the cooler display</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:opendeepcool</annotate>
  </action>

  <!--
    Phase 11: the settings app's Start at boot switch runs opendeepcool-boot through pkexec,
    which picks an action by the program's full path and, where an action has the argv1
    annotation, only when the program's first argument is that value (pkexec(1)). Phase 11a:
    one action for `on` and one for `off`, so the password prompt says which of the two is
    asked (owner, 2026-11-19). The administrator's password at every change, stricter than
    systemd's own auth_admin_keep for its unit actions.
  -->
  <action id="io.github.dtmarangoni.OpenDeepCool1.start-at-boot-on">
    <description>Start the cooler service automatically at boot</description>
    <message>Automatically start the cooler service at boot.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/opendeepcool/opendeepcool-boot</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">on</annotate>
  </action>

  <action id="io.github.dtmarangoni.OpenDeepCool1.start-at-boot-off">
    <description>Stop starting the cooler service automatically at boot</description>
    <message>Disable automatic cooler service start at boot.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/opendeepcool/opendeepcool-boot</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">off</annotate>
  </action>
</policyconfig>
