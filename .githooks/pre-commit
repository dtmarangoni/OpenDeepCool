#!/usr/bin/env bash
# OpenDeepCool pre-commit guard (AGENTS.md rules 6 and 10).
#
# Rejects commits that would publish proprietary, local-only or personal data:
#   - a commit identity other than the GitHub no-reply address
#   - files under local-only folders (vendor manuals, the owner's machine
#     notes, research artefacts)
#   - binary/vendor file types: installers, DLLs, Electron bundles, V8
#     bytecode, native modules, firmware, PDFs, USB captures
#   - any file larger than 2 MiB
#   - text files carrying DeepCreative code signatures
#   - text containing a sensitive value listed in docs/local/machine.md
#
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
source "$(dirname "$0")/sensitive-values.sh"

max_bytes=$((2 * 1024 * 1024))
blocked_path='^(docs/reference/vendor/|docs/local/|research/|captures/)'
blocked_ext='\.(exe|dll|sys|msi|asar|jsc|node|pak|7z|bin|pdf|pcap|pcapng)$'
code_markers='__vitePreload|defineStore\("lpStore"|bytecode-loader'

values_file=$(mktemp)
trap 'rm -f "${values_file}"' EXIT
sensitive_values > "${values_file}"

fail=0

identity="$(git config user.name) <$(git config user.email)>"
if [[ ${identity} != *"@users.noreply.github.com>" ]]; then
  echo "blocked: commit identity is not the GitHub no-reply address (see AGENTS.md rule 10)"
  fail=1
fi
if [[ -s ${values_file} ]] && grep -qiF -f "${values_file}" <<<"${identity}"; then
  echo "blocked: commit identity contains a sensitive value"
  fail=1
fi

while IFS= read -r -d '' path; do
  lower="${path,,}"
  if [[ ${path} =~ ${blocked_path} ]]; then
    echo "blocked: ${path} (local-only folder)"
    fail=1
    continue
  fi
  if [[ ${lower} =~ ${blocked_ext} ]]; then
    echo "blocked: ${path} (binary or vendor file type)"
    fail=1
    continue
  fi
  size=$(git cat-file -s ":${path}")
  if (( size > max_bytes )); then
    echo "blocked: ${path} (${size} bytes, limit ${max_bytes})"
    fail=1
    continue
  fi
  # Markdown may quote these names; the guard itself defines them.
  if [[ ${lower} != *.md && ${path} != .githooks/* ]] && git show ":${path}" | grep -qE "${code_markers}"; then
    echo "blocked: ${path} (looks like DeepCreative code)"
    fail=1
  fi
  if [[ -s ${values_file} ]]; then
    hit=$(git show ":${path}" | grep -I -o -i -F -f "${values_file}" | head -1 || true)
    if [[ -n ${hit} ]]; then
      echo "blocked: ${path} contains a sensitive value (\"${hit}\")"
      fail=1
    fi
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if (( fail )); then
  echo
  echo "Commit rejected: vendor material, personal or machine-specific data, and large binaries never go into this public repository."
  echo "Keep such facts in docs/local/machine.md (git-ignored)."
  exit 1
fi
